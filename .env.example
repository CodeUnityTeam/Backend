### BACKEND
POSTGRES_DB=code_unity
POSTGRES_USER=code_unity_user
POSTGRES_PASSWORD=code_unity_password
DB_NAME=code_unity
DB_HOST=db
DB_MODE=network  # network | local
# Альтернативный хост для локального подключения (когда DB_MODE=local)
DB_HOST_LOCAL=localhost
DB_PORT=5432

S3_ENDPOINT_URL=http://minio:9000  # Внутренний endpoint для Django (docker hostname)

# Публичный URL для доступа браузера через nginx (БЕЗ протокола).
# Примеры:
#   dev-сервер: dev.code-unity.ru/media
#   прод:       code-unity.ru/media
#   локально:   localhost:9000 (тогда нужен AWS_S3_URL_PROTOCOL=http:)
# ⚠️ ВАЖНО: значение должно быть БЕЗ http:// или https://
S3_PUBLIC_URL=

# Протокол для публичных URL (http: или https:).
# По умолчанию https: — для продакшена через nginx.
# Для локальной разработки с MinIO нужно http: (иначе URL будут с https://,
# а MinIO не отвечает по HTTPS).
AWS_S3_URL_PROTOCOL=http:

