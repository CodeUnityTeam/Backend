# Окружение
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.so
*.db

# Миграции — применяются через manage.py migrate при старте контейнера
migrations/
**/migrations/
!**/migrations/__init__.py

# Статика и медиа — собираются отдельно (S3 / volume)
media/
staticfiles/
static/

# Логи
logs/
*.log

# Конфиги разработки — в контейнере не нужны
ruff.toml
uv.lock

# VCS
.git/
.gitignore
.gitattributes

# IDE
.idea/
.vscode/
*.swp
*.swo

# Docker
.dockerignore
.backend.yaml
docker-compose*.yml
docker-compose*.yaml

# Документация
readme.md
README.md
docs/

# CI/CD
.github/

# OS
.DS_Store
Thumbs.db

# Postgres volume
postgres_data/

# Тестовые данные — не нужны в production-образе
# Теги (fixtures/tags/) оставляем — нужны для бизнес-логики
fixtures/test_data/

# Тесты — не нужны в production-образе
tests/

# Nginx — свой отдельный контейнер
nginx/