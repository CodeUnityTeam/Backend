# @name PR3. Просмотр списка проектов
GET http://127.0.0.1:8000/api/v1/projects/
Authorization: Bearer {{access2}}
Content-Type: application/json
###

# @name PR4. Просмотр деталей проекта
GET http://127.0.0.1:8000/api/v1/projects
    /3b3ad921-97f3-49a7-b096-43938b1219b5/
Authorization: Bearer {{access2}}
Content-Type: application/json
###

# ============================== ОТКЛИКИ ===============================

# @name R1. Приглашение пользователя на проект
POST http://127.0.0.1:8000/api/v1/projects
    /30d82112-687a-4f94-9c23-23387c1ac8d7
    /invite
    /78ad8b7f-3286-4723-b5dd-82a5bef0e08a/
Authorization: Bearer {{access2}}
Content-Type: application/json
###

# @name R2. Просмотр списка откликов
GET http://127.0.0.1:8000/api/v1/user/profile/
    ?responses=true
Authorization: Bearer {{access2}}
Content-Type: application/json
###

# @name R3. Отклик на проект
POST http://127.0.0.1:8000/api/v1/projects
    /3b3ad921-97f3-49a7-b096-43938b1219b5
    /responses/
Authorization: Bearer {{access}}
Content-Type: application/json
###

# @name R4. Одобрить отклик на проект
PATCH http://127.0.0.1:8000/api/v1/projects
    /responses
    /5c8b773e-cb75-46eb-97b5-79fbd2b07b70
    /status/
Authorization: Bearer {{access2}}
Content-Type: application/json

{
  "status": "approved"
}
###